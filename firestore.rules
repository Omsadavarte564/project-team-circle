rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow any logged-in user to read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow any logged-in user to read/write the global appData
    match /appData/global {
      allow read, write: if request.auth != null;
    }
  }
}
